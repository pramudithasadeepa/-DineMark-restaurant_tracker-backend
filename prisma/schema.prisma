generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int          @id @default(autoincrement())
  email     String       @unique
  password  String
  name      String
  createdAt DateTime     @default(now())
  restaurants Restaurant[]
}

model Restaurant {
  id            Int       @id @default(autoincrement())
  name          String
  cuisine       String
  location      String
  priceRange    String    // "budget", "medium", "expensive"
  imageUrl      String?
  status        String    // "want_to_try", "visited"
  rating        Int?
  review        String?
  visitedDate   DateTime?
  whatIOrdered  String?
  recommendedDish String?
  pricePaid     Float?
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}